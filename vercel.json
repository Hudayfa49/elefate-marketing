{
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/blog-wat-is-geo",
      "destination": "/blog/wat-is-geo",
      "permanent": true
    },
    {
      "source": "/blog-lokale-seo",
      "destination": "/blog/lokale-seo",
      "permanent": true
    },
    {
      "source": "/blog-wat-is-structured-data",
      "destination": "/blog/wat-is-structured-data",
      "permanent": true
    },
    {
      "source": "/seo-geo",
      "destination": "/diensten/seo-geo",
      "permanent": true
    },
    {
      "source": "/webdesign",
      "destination": "/diensten/webdesign",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/bricolage-grotesque.woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/instrument-sans.woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/jetbrains-mono.woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
